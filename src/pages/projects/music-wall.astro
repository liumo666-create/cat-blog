---
import Layout from "@layouts/Layout.astro";
import NavBar from "@components/NavBar.astro";
---

<Layout title="音乐墙 - 项目详情">
  <div class="game-scene">
    <div class="scroll-container">
      <div class="web-wrapper">
        <NavBar />

        <div class="section-page active" id="page-project-detail-5">
          <div class="main-col" style="width:100%">
            <a href="/projects/" class="proj-detail-back" style="display:inline-flex; align-items:center; text-decoration:none; color:inherit; cursor:pointer;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
              返回项目列表
            </a>

            <div class="music-wall-stage">
              <iframe
                src="/music-wall/index.html"
                frameborder="0"
                allow="autoplay; fullscreen"
                title="3D 音乐墙"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .music-wall-stage {
    width: 100%;
    height: min(720px, calc(100vh - 170px));
    min-height: 520px;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border-hi, rgba(255,255,255,0.1));
    background: #000;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
    position: relative;
  }

  iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    background: #000;
  }

  @media (max-width: 768px) {
    .music-wall-stage {
      height: calc(100vh - 170px);
      min-height: 480px;
      border-radius: 12px;
    }
  }
</style>
